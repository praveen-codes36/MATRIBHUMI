NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# LOCAL_CONFIGURATION: use MongoDB Atlas or a replica set, not standalone MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017/matribhumi?replicaSet=rs0
# CONFIGURATION_PLACEHOLDER: generate your own random secrets; never commit .env.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=30m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d
FRONTEND_URL=http://localhost:5173
MAIL_FROM=
ETHEREAL_SMTP_HOST=
ETHEREAL_SMTP_PORT=587
ETHEREAL_SMTP_USER=
ETHEREAL_SMTP_PASS=
# INTEGRATION_TODO: see docs/PERSON_B_API.md for A/C contracts. Include trailing slash.
PERSON_A_BASE_URL=
PERSON_C_BASE_URL=
INTEGRATION_SERVICE_TOKEN=
# MOCK_REPLACE: optional development seed only; never enabled automatically.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
